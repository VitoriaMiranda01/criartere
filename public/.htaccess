# SPA (React Router): envia rotas desconhecidas para o index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Endereço único: https://criartere.com.br (sem www e sempre com HTTPS)
  RewriteCond %{HTTP_HOST} ^www\.criartere\.com\.br$ [NC]
  RewriteRule ^(.*)$ https://criartere.com.br/$1 [R=301,L]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} ^criartere\.com\.br$ [NC]
  RewriteRule ^(.*)$ https://criartere.com.br/$1 [R=301,L]

  RewriteRule ^index\.html$ - [L]

  # A loja fica na raiz do site; endereços antigos /loja/... redirecionam (o painel fica em /admin)
  RewriteRule ^loja/?$ / [R=301,L]
  RewriteRule ^loja/(.+)$ /$1 [R=301,L]
  RewriteRule ^(login|pedidos|orcamentos|clientes|produtos|financeiro|fluxo-de-caixa|relatorios|configuracoes|ajuda)/?$ /admin/$1 [R=301,L,QSA]

  # Páginas da loja pré-geradas no build (SEO e prévias de link no WhatsApp/Instagram).
  # Se o arquivo não existir, segue para o app normalmente.
  RewriteCond %{REQUEST_URI} ^/(produto/[a-z0-9-]+)/?$
  RewriteCond %{DOCUMENT_ROOT}/_paginas/%1.html -f
  RewriteRule ^ /_paginas/%1.html [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# PWA: tipos e cache
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|.+\.html|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Segurança: cabeçalhos HTTP
<IfModule mod_headers.c>
  # Força HTTPS por 1 ano
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Impede o navegador de "adivinhar" o tipo dos arquivos
  Header always set X-Content-Type-Options "nosniff"
  # Impede que o sistema seja carregado dentro de outro site (clickjacking)
  Header always set X-Frame-Options "DENY"
  # Não envia o endereço completo das páginas para outros sites
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Idioma do site: português do Brasil (o navegador não oferece tradução)
  Header always set Content-Language "pt-BR"
  # Desliga recursos do navegador que o sistema não usa
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # Só carrega scripts, estilos e conexões de origens conhecidas
  # Login com Google: libera só os endereços do botão oficial do Google (accounts.google.com/gsi)
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://kitarrykwoaxlrydethm.supabase.co wss://kitarrykwoaxlrydethm.supabase.co https://accounts.google.com/gsi/; worker-src 'self' blob:; manifest-src 'self'; frame-src 'self' https://accounts.google.com/gsi/; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
  Header always unset X-Powered-By
</IfModule>

# Bloqueia acesso a arquivos ocultos (ex.: .git, .env) caso existam no servidor
<IfModule mod_rewrite.c>
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
</IfModule>
